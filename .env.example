# Copy to .env.local. Leave these empty in git. Never commit real keys.

# Supabase project URL, for example https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (the current name for the anon key). Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (the current name for the service-role key). Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token for POST /api/cron/discover. Generate a long random string.
CRON_SECRET=

# The one account allowed to sign in. Compared case-insensitively.
OWNER_EMAIL=
